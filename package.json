{
  "name": "things-terminal",
  "version": "2.0.0",
  "description": "Personal device registry with Express + SQLite",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch server.js --watch server --watch modules --watch shared --ext js --exec node server.js",
    "start": "node server.js",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=1",
    "test:browser": "playwright test",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "98.css": "^0.1.21",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "nodemon": "^3.1.10"
  }
}
