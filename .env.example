# HTTP port
PORT=3000

# Required for production. Local development may leave it empty.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Runtime paths. Relative values resolve from the repository root.
DATA_DIR=./data/runtime
DB_PATH=./data/runtime/devices.sqlite
UPLOAD_DIR=./public/uploads
SEED_DB_PATH=./data/devices.sqlite

# Network and logging
TRUST_PROXY=0
LOG_LEVEL=info
